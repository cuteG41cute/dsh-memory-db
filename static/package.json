{
    "name":  "dsh-memory-db",
    "version":  "0.6.1",
    "description":  "DeepSeek Harness static plugin: per-project memory database (collect/classify/inject/admin page). Budget uses real LLM usage tokens (falls back to log estimate); compacts history first when room for injection is insufficient. Compatible with dsh 0.1.x and 0.2.x (settings API fallback + snapshotEvents).",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-client-runtime",
                                              "@deepseek-ai/dsh-client-ui-settings",
                                              "@deepseek-ai/dsh-client-ui-slots"
                                          ]
                           }
            },
    "files":  [
                  "lib"
              ],
    "keywords":  [
                     "deepseek-harness",
                     "dsh",
                     "cordis",
                     "plugin",
                     "memory",
                     "memory-db"
                 ],
    "license":  "MIT",
    "author":  "cuteG41cute",
    "dependencies":  {
                         "@deepseek-ai/cordis":  "^4.0.1",
                         "@deepseek-ai/schemastery":  "^3.18.1"
                     }
}
